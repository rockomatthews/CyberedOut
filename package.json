{
  "name": "cyberedout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "start:web": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "agent": "node --import tsx scripts/agent.ts",
    "format": "prettier --write src scripts tests next.config.ts",
    "test:smoke": "node tests/http-smoke.mjs",
    "world": "node --import tsx scripts/world-server.ts",
    "test:multiplayer": "node --import tsx tests/multiplayer-smoke.mjs",
    "dot": "node --import tsx scripts/dot.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.5.0",
    "@mui/material-nextjs": "9.5.0",
    "@supabase/supabase-js": "2.118.0",
    "@theatre/core": "0.7.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "stripe": "23.0.1",
    "three": "0.186.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "type": "module"
}
