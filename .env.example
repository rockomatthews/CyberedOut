# The web client runs on Vercel; the road server runs on a persistent WebSocket host.
# For localhost, the client automatically uses ws://localhost:3020.
NEXT_PUBLIC_WORLD_SERVER_URL=
WORLD_SERVER_URL=http://127.0.0.1:3020
WORLD_PORT=3020
WORLD_DATA_FILE=.local/world-identities.json
WORLD_ALLOWED_ORIGINS=http://localhost:3018,http://localhost:3000

# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# A long random secret for hashing signup rate-limit identifiers.
RATE_LIMIT_SECRET=
# 32 random bytes encoded as 64 hex characters; encrypts provider tokens.
CONNECTION_ENCRYPTION_KEY=
# Stripe Standard Connect application; OAuth requests read_write scope.
# App code initially exposes reconciliation and owner-created checkout only.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=
# Plaid bank transaction feed, no money movement. Start with sandbox.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
